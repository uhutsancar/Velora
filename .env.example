# ============================================================================
#  Velora - production environment template
#
#      cp .env.example .env
#
#  .env is git-ignored and must stay that way. Every value below is read by
#  docker-compose.prod.yml; the ones marked REQUIRED have no default and the
#  stack refuses to start without them - a service that boots with a blank
#  signing key would reject every token at runtime instead of failing loudly.
#
#  Generate the secrets, never invent them by hand:
#      openssl rand -base64 48      # AUTH_SIGNING_KEY
#      openssl rand -base64 24      # SQL_SA_PASSWORD / REDIS_PASSWORD / RABBITMQ_PASSWORD
# ============================================================================

# ---------------------------------------------------------------- secrets --
# REQUIRED. HMAC-SHA256 signing key shared by every service. At least 32
# characters. Rotating it invalidates every access token in circulation.
AUTH_SIGNING_KEY=

# REQUIRED. SQL Server sa password. Must satisfy the SQL Server complexity
# policy: 8+ characters with upper, lower, digit and symbol.
SQL_SA_PASSWORD=

# REQUIRED. Redis password (basket, wishlist and checkout idempotency keys).
REDIS_PASSWORD=

# REQUIRED. RabbitMQ broker credentials.
RABBITMQ_USER=velora
RABBITMQ_PASSWORD=

# --------------------------------------------------------------- bootstrap --
# Leave both blank to skip creating an admin account. When blank, IdentityService
# logs a warning and creates nothing - there is deliberately no default password
# outside Development. Create the first admin here, then change the password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ----------------------------------------------------------------- public --
# REQUIRED. Public URL of the API gateway. Baked into both frontend images at
# build time, so changing it means rebuilding them.
API_PUBLIC_URL=https://api.velora.com

# Origin serving product images. Defaults to API_PUBLIC_URL when unset.
MEDIA_PUBLIC_URL=

# REQUIRED. The two browser origins. They are also the CORS allow-list the
# services enforce, so a missing one blocks that app's API calls.
STOREFRONT_ORIGIN=https://store.velora.com
ADMIN_ORIGIN=https://admin.velora.com

# ------------------------------------------------------------------ brand --
SITE_NAME=Velora
ADMIN_APP_NAME=Velora Admin
CURRENCY=TRY

# ------------------------------------------------------------------ ports --
# Host ports. Behind a reverse proxy terminating TLS these normally stay
# internal; publish only what the proxy needs to reach.
GATEWAY_PORT=5000
STOREFRONT_PORT=8080
ADMIN_PORT=8081

# ----------------------------------------------------------------- images --
# Tag applied to every built image. Use a release or commit tag in CI.
VELORA_TAG=latest

# ------------------------------------------------------------- event bus ----
# RabbitMQ (default) or AzureServiceBus. With AzureServiceBus also set
# EVENTBUS_CONNECTION_STRING and pass it through as EventBus__ConnectionString.
EVENTBUS_TYPE=RabbitMQ
EVENTBUS_CONNECTION_STRING=

# ---------------------------------------------------------------- payment --
# The payment service is a stand-in for a real PSP: true authorises every
# payment, false declines every payment. Wire a real provider before taking
# money.
PAYMENT_SUCCESS=true
