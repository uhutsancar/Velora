    "@reduxjs/toolkit": "^2.5.0",
    "@velora/shared": "workspace:*",
    "axios": "^1.7.9",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "formik": "^2.4.6",
    "framer-motion": "^11.15.0",
    "i18next": "^24.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
