# API gateway (Ocelot). All storefront traffic goes through it.
VITE_API_URL=http://localhost:5000

# Origin used to resolve relative media paths returned by CatalogService.
VITE_MEDIA_ORIGIN=http://localhost:5004

# Public site URL, used for canonical links and structured data.
VITE_SITE_URL=http://localhost:5173

VITE_SITE_NAME=Velora
VITE_CURRENCY=TRY
